# ════════════════════════════════════════════════════════════
#  Banana News — variables de entorno
#  Copia este archivo como .env (no se sube a git) y completa.
#  [PROD] = obligatoria en producción. El resto es opcional:
#  sin ella, la app usa un modo local (ver cada sección).
#  Guía paso a paso: DEPLOY.md
# ════════════════════════════════════════════════════════════

# ─── Servidor ───────────────────────────────────────────────
# [PROD] En el servidor: production (activa avisos de claves de prueba, cookies seguras)
# NODE_ENV=production
# Puerto del servidor Node (Railway lo define solo)
# PORT=4321

# ─── Base de datos y sesiones ──────────────────────────────
# [PROD] Postgres, p. ej. ${{Postgres.DATABASE_URL}} en Railway.
# Vacía en desarrollo = PGlite local en .data/pglite (un solo proceso a la vez)
DATABASE_URL=
# [PROD] Firma las sesiones del panel. Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# [PROD] URL pública del sitio, sin barra final (también define los dominios permitidos para formularios)
SITE_URL=http://localhost:4321
# Primera cuenta de administrador: al arrancar, si la base no tiene cuentas, se crea y se envía por correo
# el enlace para elegir la contraseña. Con alguna cuenta ya creada no hace nada.
# ADMIN_INICIAL=tu@correo.com
# ADMIN_INICIAL_NOMBRE=Tu Nombre
# [PROD] Sal secreta para el hash de IP de los envíos. Genera con: openssl rand -base64 32
# Si la cambias, los hashes antiguos dejan de coincidir con los nuevos. En producción, sin ella la app no arranca.
# IP_SALT=
# [PROD] Secreto que Cloudflare agrega a cada petición (cabecera x-bn-origen, ver DEPLOY.md §2.7).
# Con él definido, el servidor rechaza lo que no llegue por Cloudflare. Genera con: openssl rand -hex 32
# ORIGEN_SECRETO=

# ─── Cloudflare R2 (imágenes y adjuntos de denuncias) ──────
# Sin estas variables, los archivos se guardan en .data/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bananas-media
# [PROD si hay MEDIA_BASE_URL] Bucket privado, sin dominio público, para los adjuntos de denuncias
R2_BUCKET_PRIVADO=
# Dominio público conectado al bucket, p. ej. https://media.tu-dominio.com
MEDIA_BASE_URL=
# true si activaste Images → Transformations en la zona de MEDIA_BASE_URL (srcset WebP/AVIF)
MEDIA_TRANSFORMACIONES=false

# ─── Cloudflare Stream (videos) ────────────────────────────
# Sin estas variables, los videos se guardan como archivo en R2 / .data/media
CF_ACCOUNT_ID=
# Token con permiso Account → Stream → Edit
CF_STREAM_TOKEN=
# El XXXX de customer-XXXX.cloudflarestream.com (Stream → Settings)
CF_STREAM_CUSTOMER_CODE=
# Secreto que devuelve la API al registrar el webhook (ver DEPLOY.md §4)
CF_STREAM_WEBHOOK_SECRET=

# ─── Purga de caché del CDN ────────────────────────────────
# Sin estas variables, la purga solo se escribe en el log
CF_ZONE_ID=
# Token con permiso Zone → Cache Purge → Purge
CF_API_TOKEN=

# ─── Turnstile (antispam de los formularios) ───────────────
# Comentadas = claves de prueba de Cloudflare (todo pasa y el widget dice «Solo para pruebas»).
# [PROD] En producción la app no arranca con las claves de prueba.
# TURNSTILE_SITE_KEY es pública y se incrusta al compilar: cámbiala y vuelve a hacer build.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# ─── Correo (Resend) ───────────────────────────────────────
# Sin clave, los correos se escriben en el log
RESEND_API_KEY=
# Debe ser de un dominio verificado en Resend
CORREO_REMITENTE=
# Opcional: manda todos los avisos internos a un solo buzón (útil en pruebas)
CORREO_DESTINO=

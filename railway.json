{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "RAILPACK",
		"buildCommand": "pnpm build"
	},
	"deploy": {
		"preDeployCommand": "pnpm db:migrar",
		"startCommand": "pnpm start",
		"healthcheckPath": "/api/salud",
		"healthcheckTimeout": 60,
		"restartPolicyType": "ON_FAILURE"
	}
}

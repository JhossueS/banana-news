---
import Icon from './Icon.astro';

interface Props {
	nombreMascota: string;
	contacto: { nombre: string; correo: string; telefono?: string | null };
}
const { nombreMascota, contacto } = Astro.props;
const asunto = encodeURIComponent(`Quiero adoptar a ${nombreMascota}`);
const tel = contacto.telefono?.replace(/[^\d+]/g, '');
---

<div class="contacto">
	<span class="rotulo">Contacto para adoptar</span>
	<span class="quien">{contacto.nombre}</span>
	<div class="vias">
		<a class="via via--principal" href={`mailto:${contacto.correo}?subject=${asunto}`} rel="nofollow">
			<Icon name="message-circle" size={18} />
			Escribir
		</a>
		{
			tel && (
				<a class="via" href={`tel:${tel}`} rel="nofollow">
					<Icon name="phone" size={18} />
					{contacto.telefono}
				</a>
			)
		}
	</div>
</div>

<style>
	.contacto {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 14px;
		box-shadow: inset 0 0 0 2px var(--bn-negro);
		border-radius: var(--radius-s);
	}
	.rotulo {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.quien {
		font-size: 15px;
		font-weight: 700;
	}
	.vias {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.via {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 14px;
		border-radius: var(--radius-s);
		box-shadow: inset 0 0 0 2px var(--bn-negro);
		font-size: 14px;
		font-weight: 800;
		text-decoration: none;
	}
	.via--principal {
		background: var(--bn-negro);
		color: var(--bn-hueso);
	}
	.via--principal:hover {
		background: var(--bn-negro-700);
	}
	.via:not(.via--principal):hover {
		background: var(--bn-amarillo-100);
	}
	.via:active {
		opacity: 0.85;
	}
</style>

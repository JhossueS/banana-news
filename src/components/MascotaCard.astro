---
import Icon from './Icon.astro';
import Tag from './Tag.astro';
import Aviso from './Aviso.astro';
import DatosMascota from './DatosMascota.astro';
import ContactoAdopcion from './ContactoAdopcion.astro';
import { edadDesde, etiquetaEspecie, fechaCorta, type Mascota } from '../lib/mascotas';

interface Props {
	mascota: Mascota;
}
const { mascota: m } = Astro.props;
const descId = `desc-${m.id}`;
const datos = [
	{ etiqueta: 'Sexo', valor: m.sexo },
	{ etiqueta: 'Nacimiento', valor: fechaCorta(m.nacimiento), nota: edadDesde(m.nacimiento) },
	{ etiqueta: 'Especie', valor: etiquetaEspecie(m.especie) },
	{ etiqueta: 'Peso', valor: m.peso || '—' },
	{ etiqueta: 'Color', valor: m.color || '—' },
	{ etiqueta: 'Chip', valor: m.chip || '—' },
];
const href = `/adopcion/${m.slug}/`;
---

<article class="ficha" id={m.slug} aria-label={m.nombre} data-especie={m.especie}>
	<div class="foto">
		{
			m.foto ? (
				<a {href} tabindex="-1" aria-hidden="true"><img src={m.foto.src} alt={m.foto.alt} loading="lazy" decoding="async" /></a>
			) : (
				<div class="vacio">
					<Icon name="camera" size={28} />
					<span>Sin foto todavía</span>
				</div>
			)
		}
		<Tag variant="amarillo" size="sm" class="estado">En adopción</Tag>
	</div>

	<div class="cuerpo">
		<div class="titulo">
			<h3><a {href}>{m.nombre}</a></h3>
			<span class="ciudad"><Icon name="map-pin" size={16} />{m.ciudad}, {m.provincia}</span>
		</div>

		<Aviso variante="amarillo" icono="info" rotulo="Situación actual">{m.situacion}</Aviso>

		<div class="datos">
			<span class="rotulo">Información básica</span>
			<DatosMascota {datos} />
		</div>

		{
			m.condicionMedica ? (
				<Aviso variante="coral" icono="triangle-alert" rotulo="Condiciones médicas">
					{m.condicionMedica}
				</Aviso>
			) : (
				<Aviso variante="gris" icono="shield-check">
					Sin condiciones médicas conocidas
				</Aviso>
			)
		}

		<ContactoAdopcion nombreMascota={m.nombre} contacto={m.contacto} />

		<button type="button" class="abrir" aria-expanded="false" aria-controls={descId} data-nombre={m.nombre}>
			<span class="abrir-texto">Conoce a {m.nombre}</span>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
		</button>
		<p id={descId} class="desc" hidden>{m.descripcion}</p>
	</div>
</article>

<style>
	.ficha {
		display: flex;
		flex-direction: column;
		background: var(--bn-hueso);
		box-shadow: inset 0 0 0 1px var(--line-soft);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}
	.ficha[hidden] {
		display: none;
	}
	.foto {
		position: relative;
		aspect-ratio: 4 / 3;
		background: var(--bn-gris-100);
	}
	.foto a {
		display: block;
		height: 100%;
	}
	.foto img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.vacio {
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
		font-size: 13px;
		font-weight: 700;
		color: var(--bn-gris-600);
	}
	.foto :global(.estado) {
		position: absolute;
		left: 12px;
		bottom: 0;
		border-radius: 0;
	}
	.cuerpo {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 18px 20px 20px;
	}
	.titulo {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	h3 a {
		text-decoration: none;
	}
	h3 a:hover {
		text-decoration: underline;
		text-decoration-color: var(--bn-amarillo);
		text-decoration-thickness: 3px;
	}
	h3 {
		font-size: 28px;
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.015em;
	}
	.ciudad {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		font-weight: 600;
		color: var(--bn-gris-600);
	}
	.datos {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.rotulo {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.abrir {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		min-height: 44px;
		padding: 0 14px;
		border: 0;
		border-radius: var(--radius-s);
		background: var(--bn-gris-100);
		color: var(--bn-negro);
		font-size: 14px;
		font-weight: 700;
		text-align: left;
		transition: background var(--dur-fast) var(--ease-out);
	}
	.abrir:hover {
		background: var(--bn-gris-200);
	}
	.abrir svg {
		transition: transform var(--dur-base) var(--ease-out);
	}
	.abrir[aria-expanded='true'] svg {
		transform: rotate(180deg);
	}
	.desc {
		padding-left: 12px;
		font-size: 15px;
		line-height: 1.5;
		box-shadow: inset 6px 0 0 var(--bn-amarillo);
	}
	.desc[hidden] {
		display: none;
	}
</style>

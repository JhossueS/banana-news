---
import Icon, { type IconName } from './Icon.astro';

const KINDS: Record<string, { label: string; icon: IconName }> = {
	'ultima-hora': { label: 'Última hora', icon: 'zap' },
	'en-vivo': { label: 'En vivo', icon: 'radio' },
};

interface Props {
	kind?: keyof typeof KINDS;
	href: string;
}
const { kind = 'ultima-hora', href } = Astro.props;
const k = KINDS[kind];
---

<a class="infobar" {href}>
	<Icon name={k.icon} size={18} stroke={2.5} />
	<span class="text"><b>{k.label}:</b> <slot /></span>
	<Icon name="arrow-right" size={20} class="arrow" />
</a>

<style>
	.infobar {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 16px;
		background: var(--bn-coral);
		color: var(--bn-negro);
		font-size: 14px;
		line-height: 1.3;
		text-decoration: none;
		border-radius: var(--radius-s);
	}
	.text {
		flex: 1;
		min-width: 0;
	}
	b {
		font-weight: 800;
		text-transform: uppercase;
		margin-right: 4px;
	}
	.infobar :global(.arrow) {
		transition: transform var(--dur-base) var(--ease-out);
	}
	.infobar:hover .text {
		text-decoration: underline;
		text-decoration-color: var(--bn-negro);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
	}
	.infobar:hover :global(.arrow) {
		transform: translateX(4px);
	}
	.infobar:active {
		opacity: 0.85;
	}
	@media (max-width: 480px) {
		.infobar {
			font-size: 13px;
		}
	}
</style>

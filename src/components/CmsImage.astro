---
/**
 * Imagen del CMS. Con variantes optimizadas usa <picture> (AVIF → WebP) y el navegador elige la mejor que soporte;
 * las anteriores a la optimización siguen como <img>. Sin imagen, deja un bloque neutro del mismo tamaño.
 */
import type { ImagenVista } from '../lib/types';

interface Props {
	image: ImagenVista | null;
	sizes?: string;
	class?: string;
	loading?: 'eager' | 'lazy';
	fetchpriority?: 'high' | 'auto';
	/** view-transition-name: la misma foto en otra página se anima hasta aquí (ver lib/transiciones) */
	transicion?: string;
}
const { image, sizes = '100vw', class: className, loading = 'lazy', fetchpriority = 'auto', transicion } = Astro.props;
const vt = transicion ? `view-transition-name: ${transicion}; view-transition-class: foto` : undefined;
---

{
	image ? (
		<picture style="display: contents">
			{image.fuentes?.map((f) => (
				<source type={f.type} srcset={f.srcset} sizes={sizes} />
			))}
			<img
				src={image.src}
				srcset={image.srcset}
				sizes={image.srcset ? sizes : undefined}
				alt={image.alt}
				width={image.width}
				height={image.height}
				class={className}
				loading={loading}
				fetchpriority={fetchpriority}
				decoding="async"
				style={vt}
			/>
		</picture>
) : (
		<span class:list={[className, 'cms-img-vacia']} role="presentation" style={vt} />
	)
}

<style>
	.cms-img-vacia {
		display: block;
		background: var(--bn-gris-200);
	}
</style>

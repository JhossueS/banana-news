---
/** Franja amarilla con una frase y un botón negro. */
import Icon from './Icon.astro';

interface Props {
	href: string;
	label: string;
}
const { href, label } = Astro.props;
---

<section class="cta-band" aria-label={label}>
	<p class="cta-title"><slot /></p>
	<a {href} class="cta-btn">
		{label}
		<Icon name="arrow-right" size={18} />
	</a>
</section>

<style>
	.cta-band {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 24px;
		padding: clamp(20px, 3vw, 28px) clamp(20px, 3vw, 32px);
		background: var(--bn-amarillo);
	}
	.cta-title {
		font-size: clamp(22px, 2.6vw, 26px);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.01em;
	}
	.cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 48px;
		padding: 0 20px;
		background: var(--bn-negro);
		color: var(--bn-hueso);
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
		border-radius: var(--radius-s);
	}
	.cta-btn :global(svg) {
		transition: transform var(--dur-base) var(--ease-out);
	}
	.cta-btn:hover {
		background: var(--bn-negro-700);
	}
	.cta-btn:hover :global(svg) {
		transform: translateX(4px);
	}
	.cta-btn:active {
		opacity: 0.85;
	}
	.cta-btn:focus-visible {
		outline-color: var(--bn-negro);
		box-shadow: 0 0 0 3px var(--bn-hueso);
	}
	@media (max-width: 720px) {
		.cta-btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>

---
/** Mapa de noticias de la portada: solo lectura. Publicar vive en /publicar/. */
import Tag from './Tag.astro';
import Icon from './Icon.astro';
import MapCanvas from './MapCanvas.astro';
import type { MapNews } from '../lib/types';

interface Props {
	/** Puntos iniciales; el script los refresca desde /api/publica/mapa */
	puntos: MapNews[];
}
const { puntos } = Astro.props;
// JSON dentro de <script>: escapar «<» para que nadie pueda cerrar la etiqueta desde un titular
const datos = JSON.stringify(puntos).replace(/</g, '\\u003c');
---

<section id="mapa" class="nmap map-section" data-mode="ver" aria-labelledby="h-mapa">
	<script type="application/json" id="map-data" set:html={datos} />
	<div class="head">
		<div class="head-text">
			<div class="title-row">
				<h2 id="h-mapa" class="h2">Mapa de noticias</h2>
				<Tag variant="amarillo" size="sm" icon="map-pin">Solo Ecuador</Tag>
			</div>
			<p class="lede">Lo que pasa en las 24 provincias, en el lugar donde ocurre. Toca un punto para ver la noticia.</p>
		</div>
		<ul class="legend" aria-label="Leyenda del mapa">
			<li><span class="dot dot--ok"></span>Verificada</li>
			<li><span class="dot dot--urgent"></span>Última hora</li>
			<li><span class="dot dot--pending"></span>Sin verificar (enviada por lectores)</li>
		</ul>
	</div>

	<div class="layout">
		<div class="map-col">
			<MapCanvas />
		</div>

		<aside class="side" aria-label="Noticias del mapa">
			<div id="map-detail" class="detail" aria-live="polite"></div>
			<hr />
			<div id="map-explore" class="explore"></div>
			<a href="/publicar/" class="publish-link">
				<span class="publish-ic"><Icon name="map-pin" size={18} /></span>
				<span class="publish-txt">
					<b>¿Pasa algo cerca de ti?</b>
					<span>Publica una noticia en el mapa</span>
				</span>
				<Icon name="arrow-right" size={20} class="arrow" />
			</a>
		</aside>
	</div>
</section>

<style is:global>
	#mapa {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	#mapa .head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
	}
	#mapa .head-text {
		display: flex;
		flex-direction: column;
		gap: 10px;
		max-width: 720px;
	}
	#mapa .title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}
	#mapa .h2 {
		font-size: clamp(28px, 3.2vw, 36px);
		font-weight: 800;
		line-height: 1.06;
		letter-spacing: -0.015em;
	}
	#mapa .lede {
		max-width: 62ch;
		font-size: 18px;
		line-height: 1.4;
		color: var(--bn-gris-600);
	}
	#mapa .legend {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 13px;
		font-weight: 600;
		color: var(--bn-gris-600);
	}
	#mapa .legend li {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	#mapa .dot {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		box-shadow: inset 0 0 0 2px var(--bn-negro);
	}
	#mapa .dot--ok {
		background: var(--bn-amarillo);
	}
	#mapa .dot--urgent {
		background: var(--bn-coral);
	}
	#mapa .dot--pending {
		background: #fff;
	}

	/* Noticia elegida */
	#mapa .detail {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
	}
	#mapa .d-status {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 9px;
		font-size: 12px;
		font-weight: 800;
		line-height: 1;
		border-radius: var(--radius-s);
		box-shadow: inset 0 0 0 2px var(--bn-negro);
	}
	#mapa .d-status--ok {
		background: var(--bn-negro);
		color: var(--bn-hueso);
	}
	#mapa .d-status--urgent {
		background: var(--bn-coral);
		box-shadow: inset 0 0 0 2px var(--bn-coral);
	}
	#mapa .d-status--pending {
		background: transparent;
	}
	#mapa .d-kicker {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--bn-gris-600);
	}
	#mapa .d-title {
		font-size: clamp(22px, 2.4vw, 26px);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.015em;
	}
	#mapa .d-place {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		font-weight: 600;
	}
	#mapa .d-read {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 48px;
		margin-top: 4px;
		padding: 0 18px;
		background: var(--bn-negro);
		color: var(--bn-hueso);
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
		border-radius: var(--radius-s);
	}
	#mapa .d-read svg {
		transition: transform var(--dur-base) var(--ease-out);
	}
	#mapa .d-read:hover {
		background: var(--bn-negro-700);
	}
	#mapa .d-read:hover svg {
		transform: translateX(4px);
	}
	#mapa .d-read:active {
		opacity: 0.85;
	}
	#mapa .d-note {
		padding: 10px 12px;
		background: var(--bn-gris-100);
		border-radius: var(--radius-xs);
		font-size: 14px;
		line-height: 1.45;
	}

	/* Enlace a publicar */
	#mapa .publish-link {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: 4px;
		padding: 14px;
		background: var(--bn-amarillo);
		text-decoration: none;
		border-radius: var(--radius-s);
	}
	#mapa .publish-ic {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		flex-shrink: 0;
		background: var(--bn-negro);
		color: var(--bn-amarillo);
		border-radius: var(--radius-s);
	}
	#mapa .publish-txt {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		font-size: 14px;
		line-height: 1.3;
	}
	#mapa .publish-txt b {
		font-size: 15px;
		font-weight: 800;
	}
	#mapa .publish-link .arrow {
		transition: transform var(--dur-base) var(--ease-out);
	}
	#mapa .publish-link:hover {
		background: var(--bn-amarillo-300);
	}
	#mapa .publish-link:hover .arrow {
		transform: translateX(4px);
	}
	#mapa .publish-link:active {
		opacity: 0.85;
	}

	@media (max-width: 720px) {
		#mapa .head {
			align-items: flex-start;
		}
		#mapa .lede {
			font-size: 15px;
		}
		#mapa .legend {
			font-size: 12px;
			gap: 6px 14px;
		}
		#mapa .dot {
			width: 12px;
			height: 12px;
		}
	}
</style>

<script>
	import '../scripts/news-map';
</script>

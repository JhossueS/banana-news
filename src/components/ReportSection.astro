---
import Anuncio from './Anuncio.astro';
import Tag from './Tag.astro';
import Icon from './Icon.astro';
import StatusPill from './StatusPill.astro';
import Turnstile from './Turnstile.astro';

interface Props {
	/** Últimas denuncias no rechazadas (ver `denunciasRecientes` en src/lib/noticias.ts) */
	recientes: { id: string; titulo: string; lugar: string; estado: 'sin-verificar' | 'verificado' | 'rechazado' }[];
}
const { recientes } = Astro.props;
---

<section id="denuncias" class="report" aria-labelledby="h-denuncia">
	<aside class="ad" aria-label="Publicidad">
		<span class="ad-label">Publicidad</span>
		<div class="ad-d"><Anuncio formato="media-pagina" /></div>
		<div class="ad-m"><Anuncio formato="banner-movil" /></div>
	</aside>

	<div class="panel on-dark">
		<div class="col-intro">
			<Tag variant="coral" size="md" icon="megaphone">Denuncia ciudadana</Tag>
			<h2 id="h-denuncia" class="h">
				¿Viste algo que debe saberse? <span class="hl">Cuéntanos.</span>
			</h2>
			<p class="lede">Tu denuncia aparece de inmediato como <b>sin verificar</b> y la redacción la revisa. Puedes enviarla de forma anónima.</p>
		</div>

		<form class="form" id="form-denuncia" novalidate>
			<label class="field">
				<span>¿Qué pasó?</span>
				<textarea name="relato" rows="3" required minlength="15" placeholder="Describe el hecho con fecha y lugar"></textarea>
				<small>Mientras más claro, mejor: qué ocurrió y cuándo.</small>
			</label>
			<label class="field">
				<span>¿Dónde?</span>
				<input type="text" name="lugar" required autocomplete="off" placeholder="Ciudad, barrio o dirección" />
			</label>
			<label class="field">
				<span>Tu contacto <em class="opt">(opcional, no se publica)</em></span>
				<input type="text" name="contacto" autocomplete="email" placeholder="Correo o teléfono, si quieres que te contactemos" />
				<small>Solo lo verá la redacción.</small>
			</label>
			<small class="adj-ayuda">Una foto ayuda a verificarlo. Hasta 50 MB.</small>
			<Turnstile theme="dark" />
			<div class="actions">
				<input type="file" id="adjunto" name="adjunto" accept="image/*,video/*" hidden />
				<button type="button" class="btn btn--ghost" id="btn-adjunto">
					<Icon name="camera" size={18} />
					<span id="adjunto-label">Adjuntar foto o video</span>
				</button>
				<button type="submit" class="btn btn--primary">
					Enviar denuncia
					<Icon name="arrow-right" size={18} />
				</button>
			</div>
			<p class="status" id="denuncia-status" role="status" aria-live="polite"></p>
		</form>

		<div class="col-list">
			<h3 class="list-title">Denuncias recientes</h3>
			{
				recientes.length ? (
					<ul class="list">
						{recientes.map((r) => (
							<li class="item">
								<StatusPill kind={r.estado === 'verificado' ? 'verificado' : 'contexto'} label={r.estado === 'verificado' ? undefined : 'Sin verificar'} inverse />
								<p class="item-title">{r.titulo}</p>
								<span class="place">
									<Icon name="map-pin" size={14} />
									{r.lugar}
								</span>
							</li>
						))}
					</ul>
				) : (
					<p class="empty">Aún no hay denuncias. Sé el primero en contarnos qué pasa en tu barrio.</p>
				)
			}
		</div>
	</div>
</section>

<style>
	.report {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		align-items: flex-start;
	}

	/* Publicidad */
	.ad {
		flex: 1 1 300px;
		max-width: 340px;
		min-height: 360px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.ad-label {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--bn-gris-600);
	}
	.ad-m {
		display: none;
	}

	/* Panel negro: en escritorio nunca pasa de 600 px (la altura de la media página); las recientes se desplazan dentro */
	.panel {
		flex: 999 1 600px;
		min-width: 0;
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		grid-template-rows: auto minmax(0, 1fr);
		grid-template-areas:
			'intro form'
			'list form';
		column-gap: 40px;
		row-gap: 24px;
		height: 600px;
		margin-top: 22px; /* alinea con la imagen del anuncio, bajo su etiqueta */
		padding: 32px clamp(24px, 4vw, 40px);
		background: var(--bn-negro);
		color: var(--bn-hueso);
	}
	.col-intro {
		grid-area: intro;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
	}
	.h {
		font-size: clamp(28px, 3vw, 36px);
		font-weight: 800;
		line-height: 1.06;
		letter-spacing: -0.02em;
	}
	.hl {
		display: inline;
		padding: 0 6px;
		background: var(--bn-amarillo);
		color: var(--bn-negro);
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}
	/* Barra de bajada de la marca: filete vertical coral de 6 px */
	.lede {
		position: relative;
		max-width: 46ch;
		padding-left: 18px;
		font-size: 17px;
		line-height: 1.45;
	}
	.lede::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 6px;
		background: var(--bn-coral);
	}

	.form {
		grid-area: form;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 13px;
		font-weight: 600;
	}
	.adj-ayuda,
	.field small {
		font-size: 12px;
		font-weight: 500;
		opacity: 0.7;
	}
	.field input,
	.field textarea {
		padding: 12px 14px;
		border: 0;
		border-radius: var(--radius-xs);
		background: var(--bn-hueso);
		color: var(--bn-negro);
		font-size: 16px;
		line-height: 1.4;
		resize: vertical;
	}
	.field input {
		min-height: 48px;
		padding-block: 0;
	}
	.field input:focus-visible,
	.field textarea:focus-visible {
		outline: 3px solid var(--bn-amarillo);
		outline-offset: 2px;
		box-shadow: none;
	}
	.field [aria-invalid='true'] {
		box-shadow: inset 0 0 0 3px var(--bn-coral);
	}
	.actions {
		display: flex;
		flex-wrap: nowrap;
		gap: 12px;
	}
	.actions .btn {
		min-width: 0;
		white-space: nowrap;
	}
	.actions .btn--primary {
		flex: none;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 48px;
		padding: 0 20px;
		border: 0;
		border-radius: var(--radius-s);
		font-size: 15px;
		transition: opacity var(--dur-fast) var(--ease-out);
	}
	.btn:active {
		opacity: 0.85;
	}
	.btn--ghost {
		background: transparent;
		color: var(--bn-hueso);
		box-shadow: inset 0 0 0 2px var(--bn-hueso);
		font-weight: 700;
		max-width: 100%;
	}
	.btn--ghost:hover {
		background: var(--bn-negro-700);
	}
	.btn--ghost span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.btn--primary {
		background: var(--bn-amarillo);
		color: var(--bn-negro);
		font-weight: 800;
	}
	.btn--primary:hover {
		background: var(--bn-amarillo-300);
	}
	.btn:focus-visible {
		outline: 3px solid var(--bn-amarillo);
		outline-offset: 3px;
		box-shadow: none;
	}
	.status:empty {
		display: none;
	}
	.status {
		min-height: 1.4em;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.4;
	}
	.status[data-kind='ok'] {
		color: var(--bn-amarillo);
	}
	.status[data-kind='error'] {
		color: var(--bn-coral);
	}

	/* Recientes */
	.col-list {
		grid-area: list;
		min-width: 0;
		min-height: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding-right: 4px;
	}
	.list-title {
		margin-bottom: 8px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--bn-gris-400);
	}
	.list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-bottom: 1px solid var(--bn-gris-600);
	}
	.item {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 16px 0;
		border-top: 1px solid var(--bn-gris-600);
	}
	.item-title {
		font-size: 18px;
		font-weight: 700;
		line-height: 1.2;
		color: var(--bn-hueso);
		text-decoration: none;
		text-decoration-color: var(--bn-amarillo);
		text-decoration-thickness: 2px;
	}
	.empty {
		padding: 16px 0;
		font-size: 15px;
		color: var(--bn-gris-400);
		border-top: 1px solid var(--bn-gris-600);
	}
	.opt {
		font-style: normal;
		font-weight: 500;
		color: var(--bn-gris-400);
	}
	.place {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		color: var(--bn-gris-400);
	}

	@media (max-width: 720px) {
		/* El banner móvil va antes que el panel y sin altura de media página */
		.ad {
			flex-basis: 100%;
			max-width: none;
			min-height: 0;
			gap: 6px;
		}
		.ad-d {
			display: none;
		}
		.ad-m {
			display: block;
		}
		/* El panel negro sangra a todo el ancho en móvil, en una sola columna y sin tope de altura */
		.panel {
			flex-basis: 100%;
			display: flex;
			flex-direction: column;
			height: auto;
			margin: 0 calc(var(--gutter) * -1);
			padding: 32px var(--gutter);
			gap: 28px;
		}
		.col-list {
			overflow: visible;
			padding-right: 0;
		}
		.actions {
			flex-wrap: wrap;
		}
		.btn,
		.actions .btn--primary {
			flex: 1 1 100%;
		}
		.item-title {
			font-size: 16px;
			line-height: 1.25;
		}
	}
</style>

<script>
	import { actions } from 'astro:actions';
	import { conBoton, leerError, renovarTurnstile } from '../scripts/envio';
	import { evento } from '../scripts/analitica';

	const form = document.getElementById('form-denuncia') as HTMLFormElement | null;
	const status = document.getElementById('denuncia-status');
	const file = document.getElementById('adjunto') as HTMLInputElement | null;
	const fileBtn = document.getElementById('btn-adjunto');
	const fileLabel = document.getElementById('adjunto-label');

	fileBtn?.addEventListener('click', () => file?.click());
	file?.addEventListener('change', () => {
		if (fileLabel) fileLabel.textContent = file.files?.[0]?.name ?? 'Adjuntar foto o video';
	});

	const say = (msg: string, kind: 'ok' | 'error') => {
		if (!status) return;
		status.textContent = msg;
		status.dataset.kind = kind;
	};

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]'));
		fields.forEach((f) => f.removeAttribute('aria-invalid'));
		const bad = fields.find((f) => !f.checkValidity());
		if (bad) {
			bad.setAttribute('aria-invalid', 'true');
			bad.focus();
			say(
				bad.name === 'relato'
					? 'Cuéntanos qué pasó con al menos una frase completa.'
					: 'Indica dónde ocurrió: ciudad, barrio o dirección.',
				'error',
			);
			return;
		}
		const f = file?.files?.[0];
		if (f && f.size > 50 * 1024 * 1024) {
			say('El archivo pesa más de 50 MB. Elige uno más liviano.', 'error');
			return;
		}
		say(f ? 'Enviando tu denuncia y el archivo…' : 'Enviando…', 'ok');
		const { error } = await conBoton(form, () => actions.denuncia(new FormData(form)));
		renovarTurnstile(form);
		if (error) {
			const { campo, mensaje } = leerError(error);
			const el = campo ? form.elements.namedItem(campo) : null;
			if (el instanceof HTMLElement) {
				el.setAttribute('aria-invalid', 'true');
				el.focus();
			}
			say(mensaje, 'error');
			return;
		}
		evento('denuncia_enviada', { adjunto: f ? 'si' : 'no' });
		form.reset();
		if (fileLabel) fileLabel.textContent = 'Adjuntar foto o video';
		say('Recibimos tu denuncia. Ya aparece como «sin verificar» y la redacción la revisará.', 'ok');
	});
</script>

---
/** Texto largo de la marca: notas, páginas institucionales y legales. */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
	<slot />
</div>

<style>
	.prose {
		font-size: 18px;
		line-height: 1.7;
	}
	.prose :global(> * + *) {
		margin-top: 1.1em;
	}
	.prose :global(h2) {
		margin-top: 1.8em;
		font-size: clamp(24px, 2.6vw, 28px);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.015em;
		scroll-margin-top: 24px;
	}
	.prose :global(> h2:first-child) {
		margin-top: 0;
	}
	.prose :global(h2::after) {
		content: '';
		display: block;
		width: 40px;
		height: 5px;
		margin-top: 10px;
		background: var(--bn-amarillo);
	}
	.prose :global(h3) {
		margin-top: 1.5em;
		font-size: 21px;
		font-weight: 800;
		line-height: 1.2;
	}
	.prose :global(strong) {
		font-weight: 800;
	}
	.prose :global(a) {
		font-weight: 600;
		text-decoration-color: var(--bn-amarillo-700);
	}
	.prose :global(a:hover) {
		text-decoration-color: var(--bn-negro);
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.4em;
	}
	.prose :global(li + li) {
		margin-top: 0.5em;
	}
	.prose :global(ul) {
		list-style: square;
	}
	.prose :global(li::marker) {
		color: var(--bn-negro);
		font-weight: 800;
	}
	.prose :global(blockquote) {
		margin-inline: 0;
		margin-block: 1.6em;
		padding: 4px 0 4px 22px;
		border-left: 6px solid var(--bn-amarillo);
		font-size: clamp(21px, 2.4vw, 25px);
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}
	.prose :global(blockquote p) {
		margin: 0;
	}
	@media (max-width: 720px) {
		.prose {
			font-size: 17px;
		}
	}
</style>

---
/** Texto largo de la marca: notas, páginas institucionales y legales. */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
	<slot />
</div>

<style>
	.prose {
		font-size: 18px;
		line-height: 1.7;
	}
	.prose :global(> * + *) {
		margin-top: 1.1em;
	}
	.prose :global(table) {
		display: block;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: 15px;
		line-height: 1.5;
	}
	.prose :global(th),
	.prose :global(td) {
		padding: 10px 12px;
		border-bottom: 1px solid var(--line-soft);
		text-align: left;
		vertical-align: top;
	}
	.prose :global(th) {
		font-weight: 800;
	}
	.prose :global(h2) {
		margin-top: 1.8em;
		font-size: clamp(24px, 2.6vw, 28px);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.015em;
		scroll-margin-top: 24px;
	}
	.prose :global(> h2:first-child) {
		margin-top: 0;
	}
	.prose :global(h2::after) {
		content: '';
		display: block;
		width: 40px;
		height: 5px;
		margin-top: 10px;
		background: var(--bn-amarillo);
	}
	.prose :global(h3) {
		margin-top: 1.5em;
		font-size: 21px;
		font-weight: 800;
		line-height: 1.2;
	}
	.prose :global(strong) {
		font-weight: 800;
	}
	.prose :global(a) {
		font-weight: 600;
		text-decoration-color: var(--bn-amarillo-700);
	}
	.prose :global(a:hover) {
		text-decoration-color: var(--bn-negro);
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.4em;
	}
	.prose :global(li + li) {
		margin-top: 0.5em;
	}
	.prose :global(ul) {
		list-style: square;
	}
	.prose :global(li::marker) {
		color: var(--bn-negro);
		font-weight: 800;
	}
	.prose :global(blockquote) {
		margin-inline: 0;
		margin-block: 1.6em;
		padding: 4px 0 4px 22px;
		border-left: 6px solid var(--bn-amarillo);
		font-size: clamp(21px, 2.4vw, 25px);
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}
	.prose :global(blockquote p) {
		margin: 0;
	}
	/* Autor de la cita: último párrafo, solo en cursiva («— Nombre»), lo crea el modal «Cita» del panel */
	.prose :global(blockquote p:not(:first-child):has(> em:only-child)) {
		margin-top: 12px;
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--bn-gris-600);
	}
	@media (max-width: 720px) {
		.prose {
			font-size: 17px;
		}
	}

	/* Imágenes y videos de referencia insertados desde el CMS */
	.prose :global(.fig) {
		margin: 1.6em 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.prose :global(.fig img) {
		display: block;
		width: 100%;
		height: auto;
		background: var(--bn-gris-100);
	}
	.prose :global(.fig .video) {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--bn-negro);
	}
	.prose :global(.fig .video iframe),
	.prose :global(.fig .video video) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.prose :global(.fig figcaption) {
		font-size: 14px;
		line-height: 1.45;
		color: var(--bn-gris-600);
	}
	.prose :global(.fig .credito) {
		font-weight: 700;
	}
</style>

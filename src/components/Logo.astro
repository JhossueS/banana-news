---
/**
 * Logotipos de Banana News. Trazos originales de public/Artboard 1*.svg,
 * recortados a su caja real y con relleno currentColor (cambia con `color`).
 *  - bloque:   palabra + filete + banana (cabecera, pie)
 *  - palabra:  solo BANANA NEWS
 *  - isotipo:  solo la banana
 */
interface Props {
	layout?: 'bloque' | 'palabra' | 'isotipo';
	/** Alto en px del logotipo */
	height?: number;
	class?: string;
}
const { layout = 'bloque', height = 40, class: className } = Astro.props;
const shapes = {
	bloque: { viewBox: '150 453 780 172', ratio: 780 / 172 },
	palabra: { viewBox: '116 401 845 276', ratio: 845 / 276 },
	isotipo: { viewBox: '280 291 520 498', ratio: 520 / 498 },
} as const;
const s = shapes[layout];
---


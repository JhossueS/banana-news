---
/** Aviso de cookies de analítica. Oculto hasta que el script decide mostrarlo. */
---

<section id="consentimiento" class="consent" aria-labelledby="consent-titulo" hidden>
	<p id="consent-titulo" class="txt">
		Usamos cookies de Google Analytics para saber qué notas se leen. ¿Las aceptas?
		<a href="/politica-de-cookies/">Más información</a>
	</p>
	<div class="btns">
		<button type="button" class="btn" data-consent="no">Rechazar</button>
		<button type="button" class="btn" data-consent="si">Aceptar</button>
	</div>
</section>

<style>
	.consent {
		position: fixed;
		inset: auto 16px 16px;
		z-index: 50;
		display: flex;
		flex-wrap: wrap;
		gap: 12px 20px;
		align-items: center;
		justify-content: space-between;
		max-width: 760px;
		margin-inline: auto;
		padding: 16px 20px;
		background: var(--bn-negro);
		color: var(--bn-hueso);
		border-radius: var(--radius-m);
		box-shadow: 0 8px 30px rgb(0 0 0 / 0.25);
	}
	.consent[hidden] {
		display: none;
	}
	.txt {
		flex: 1 1 320px;
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
	}
	.txt a {
		color: var(--bn-amarillo);
		font-weight: 700;
	}
	.btns {
		display: flex;
		gap: 10px;
	}
	.btn {
		min-width: 110px;
		padding: 10px 16px;
		border: 0;
		border-radius: var(--radius-s);
		background: var(--bn-amarillo);
		color: var(--bn-negro);
		font: inherit;
		font-size: 14px;
		font-weight: 800;
		cursor: pointer;
	}
	.btn:focus-visible {
		outline: 3px solid var(--bn-hueso);
		outline-offset: 2px;
	}
</style>

<script>
	import { GA_ID } from 'astro:env/client';
	import { iniciarConsentimiento } from '../scripts/analitica';

	if (GA_ID) iniciarConsentimiento(GA_ID);
</script>

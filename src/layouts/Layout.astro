---
import '../styles/global.css';
import Consentimiento from '../components/Consentimiento.astro';
import { ADSENSE_CLIENTE } from '../data/anuncios';
import { absoluta, jsonLd, LEMA, NOMBRE_SITIO, OG_DEFECTO, usuarioX } from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	/** URL de la imagen para redes sociales (por defecto, la tarjeta de la marca) */
	image?: string;
	/** Texto alternativo de la imagen para redes */
	imageAlt?: string;
	/** Medidas de la imagen para redes */
	imageWidth?: number;
	imageHeight?: number;
	/** Ruta canónica; por defecto, la ruta actual sin parámetros */
	canonical?: string;
	/** Páginas que no deben aparecer en buscadores */
	noindex?: boolean;
	/** Objetos JSON-LD (schema.org) de la página */
	schema?: Record<string, unknown>[];
}
const {
	title = `${NOMBRE_SITIO}: noticias de Ecuador sin cáscara`,
	description = 'Medio digital ecuatoriano: política, economía, ciudad y ambiente, con denuncias ciudadanas y un mapa de noticias de las 24 provincias.',
	type = 'website',
	image,
	imageAlt,
	imageWidth,
	imageHeight,
	canonical = Astro.url.pathname,
	noindex = false,
	schema = [],
} = Astro.props;

const url = absoluta(canonical);
/** El panel nunca carga analítica ni anuncios */
const consentimiento = !Astro.url.pathname.startsWith('/admin');
const og = absoluta(image ?? OG_DEFECTO);
const ogAncho = image ? imageWidth : 1200;
const ogAlto = image ? imageHeight : 630;
const ogAlt = image ? imageAlt : `${NOMBRE_SITIO} · ${LEMA}`;
---

<!doctype html>
<html lang="es-EC">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/logo-512.png" />
		<meta name="theme-color" content="#171717" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-adsense-account" content={ADSENSE_CLIENTE} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
		{!noindex && <link rel="canonical" href={url} />}
		<link rel="alternate" type="application/rss+xml" title={NOMBRE_SITIO} href="/rss.xml" />

		<meta property="og:site_name" content={NOMBRE_SITIO} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={url} />
		<meta property="og:locale" content="es_EC" />
		<meta property="og:image" content={og} />
		{ogAncho && <meta property="og:image:width" content={String(ogAncho)} />}
		{ogAlto && <meta property="og:image:height" content={String(ogAlto)} />}
		{ogAlt && <meta property="og:image:alt" content={ogAlt} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={og} />
		{ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}
		{usuarioX() && <meta name="twitter:site" content={usuarioX()} />}
		{schema.map((s) => <script type="application/ld+json" set:html={jsonLd({ '@context': 'https://schema.org', ...s })} />)}
		{
			consentimiento && (
				<>
					{/* AdSense exige el código en el <head>; queda pausado hasta el consentimiento (scripts/analitica.ts) */}
					<script is:inline>(window.adsbygoogle = window.adsbygoogle || []).pauseAdRequests = 1;</script>
					<script
						is:inline
						async
						src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENTE}`}
						crossorigin="anonymous"
					/>
				</>
			)
		}
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<slot />
		{consentimiento && <Consentimiento />}
	</body>
</html>

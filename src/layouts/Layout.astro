---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}
const {
	title = 'Banana News · La noticia sin cáscara',
	description = 'Medio digital ecuatoriano. Lo importante, sin ruido: política, economía, ciudad y ambiente, con denuncias ciudadanas y un mapa de noticias de las 24 provincias.',
} = Astro.props;
---

<!doctype html>
<html lang="es-EC">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<meta name="theme-color" content="#171717" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_EC" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<slot />
	</body>
</html>

---
/** Páginas institucionales y legales: cabecera, ruta, título y bajada. */
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Crumbs from '../components/Crumbs.astro';
import Tag from '../components/Tag.astro';

interface Props {
	title: string;
	deck?: string;
	/** Etiqueta sobre el título y nombre del grupo en la ruta */
	group: 'El medio' | 'Legal';
	description?: string;
}
const { title, deck, group, description = deck } = Astro.props;
---

<Layout title={`${title} · Banana News`} description={description}>
	<Header current={null} />

	<main id="contenido" class="wrap main">
		<Crumbs items={[{ label: title }]} />
		<header class="head">
			<Tag size="md">{group}</Tag>
			<h1 class="title">{title}</h1>
			{deck && <p class="deck">{deck}</p>}
		</header>
		<slot />
	</main>

	<Footer />
</Layout>

<style>
	.main {
		display: flex;
		flex-direction: column;
		gap: 40px;
		padding-top: 20px;
	}
	.head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 18px;
		max-width: 900px;
		margin-top: -16px;
	}
	.title {
		font-size: clamp(36px, 5.6vw, 64px);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.025em;
		max-width: 20ch;
	}
	.deck {
		position: relative;
		max-width: 56ch;
		padding-left: 18px;
		font-size: clamp(18px, 2vw, 21px);
		font-weight: 500;
		line-height: 1.45;
	}
	.deck::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 6px;
		background: var(--bn-coral);
	}
	@media (max-width: 720px) {
		.main {
			gap: 32px;
			padding-top: 14px;
		}
		.head {
			gap: 14px;
			margin-top: -12px;
		}
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InfoBar from '../components/InfoBar.astro';
import NewsCard from '../components/NewsCard.astro';
import { fotoNota } from '../lib/transiciones';
import ReportSection from '../components/ReportSection.astro';
import NewsMap from '../components/NewsMap.astro';
import Icon from '../components/Icon.astro';
import BananaBuscando from '../components/BananaBuscando.astro';
import { denunciasRecientes, listarNoticias, puntosMapa, ultimaHora } from '../lib/noticias';
import { cachePublico } from '../lib/cache';
import { absoluta, NOMBRE_SITIO, organizacion } from '../lib/seo';
import { site } from '../data/site';

export const prerender = false;

// La portada se genera en el servidor y el CDN la guarda 60 s (luego la renueva en segundo plano)
cachePublico(Astro.response.headers, 60);

const [notas, urgente, recientes, puntos] = await Promise.all([listarNoticias({ limit: 4 }), ultimaHora(), denunciasRecientes(3), puntosMapa()]);
const [principal, ...laterales] = notas;
const kindBarra = urgente?.estado === 'en-vivo' ? 'en-vivo' : 'ultima-hora';

const schema = [
	{ ...organizacion() },
	{ '@type': 'WebSite', '@id': absoluta('/#sitio'), name: NOMBRE_SITIO, url: absoluta('/'), inLanguage: 'es-EC', publisher: { '@id': absoluta('/#organizacion') } },
];
---

<Layout {schema}>
	<Header />

	<main id="contenido" class="wrap main">
		<h1 class="sr-only">Banana News: noticias de Ecuador sin cáscara</h1>
		{
			urgente && (
				<InfoBar kind={kindBarra} href={`/noticias/${urgente.slug}/`}>
					{urgente.titulo}
				</InfoBar>
			)
		}

		<section id="noticias" class="news" aria-labelledby="h-noticias">
			<div class="section-head">
				<div class="section-title">
					<h2 id="h-noticias" class="h2">Noticias</h2>
					<span class="underline" aria-hidden="true"></span>
				</div>
				<a href="/noticias/" class="more">
					Todas las noticias
					<Icon name="arrow-right" size={18} />
				</a>
			</div>
			{
				principal ? (
					<div class="news-grid">
						<NewsCard
							class="news-main"
							variant="principal"
							image={principal.imagen}
							tag={principal.seccion.toUpperCase()}
							title={principal.titulo}
							href={`/noticias/${principal.slug}/`}
							transicion={fotoNota(principal.slug)}
							deck={principal.bajada}
							priority
						/>
						<div class="news-side">
							{laterales.map((n) => (
								<NewsCard variant="horizontal" image={n.imagen} kicker={n.seccion} title={n.titulo} href={`/noticias/${n.slug}/`} deck={n.bajada} transicion={fotoNota(n.slug)} />
							))}
						</div>
					</div>
				) : (
					<p class="news-empty">Pronto publicaremos las primeras noticias.</p>
				)
			}
		</section>

		<ReportSection recientes={recientes} />

		<NewsMap puntos={puntos} />

		{
			site.empleosUrl ? (
				<section id="empleos" class="jobs" aria-labelledby="h-empleos">
					<div class="jobs-text">
						<h2 id="h-empleos" class="jobs-title">Ofertas de trabajo en todo Ecuador</h2>
					</div>
					<a href={site.empleosUrl} class="jobs-cta">
						Ver ofertas
						<Icon name="arrow-right" size={18} />
					</a>
				</section>
			) : (
				<section id="empleos" class="jobs jobs--pronto" aria-labelledby="h-empleos">
					<BananaBuscando class="jobs-ilus" width={168} />
					<div class="jobs-text">
						<span class="jobs-pill">Próximamente</span>
						<h2 id="h-empleos" class="jobs-title">Ofertas de trabajo en todo Ecuador</h2>
						<p class="jobs-deck">Estamos buscando empleos en las 24 provincias. Muy pronto podrás encontrarlos aquí.</p>
					</div>
				</section>
			)
		}
	</main>

	<Footer />
</Layout>

<style>
	.main {
		display: flex;
		flex-direction: column;
		gap: 56px;
		padding-top: 24px;
	}

	/* Noticias */
	.news-empty {
		padding: 32px 0;
		font-size: 17px;
		color: var(--bn-gris-600);
	}
	.news {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 12px 16px;
	}
	.section-title {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.h2 {
		font-size: clamp(28px, 3.2vw, 36px);
		font-weight: 800;
		line-height: 1.06;
		letter-spacing: -0.015em;
	}
	.more {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 44px;
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
	}
	.more:hover {
		text-decoration: underline;
		text-decoration-color: var(--bn-amarillo);
		text-decoration-thickness: 3px;
	}
	.more :global(svg) {
		transition: transform var(--dur-base) var(--ease-out);
	}
	.more:hover :global(svg) {
		transform: translateX(4px);
	}
	.underline {
		width: 48px;
		height: 6px;
		background: var(--bn-amarillo);
	}
	.news-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
	}
	.news-grid :global(.news-main) {
		flex: 999 1 600px;
		min-width: 0;
		min-height: 500px;
	}
	.news-side {
		flex: 1 1 360px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	/* Empleos */
	.jobs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 24px;
		padding: clamp(20px, 3vw, 28px) clamp(20px, 3vw, 32px);
		background: var(--bn-amarillo);
	}
	/* Próximamente: la banana busca con la lupa junto al texto */
	.jobs--pronto {
		flex-wrap: nowrap;
		justify-content: flex-start;
		gap: clamp(16px, 3vw, 32px);
		overflow: hidden;
	}
	.jobs--pronto .jobs-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		max-width: 52ch;
	}
	.jobs-pill {
		display: inline-flex;
		align-items: center;
		min-height: 28px;
		padding: 0 12px;
		background: var(--bn-negro);
		color: var(--bn-amarillo);
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		border-radius: 999px;
	}
	.jobs-deck {
		font-size: 16px;
		line-height: 1.45;
		color: var(--bn-negro-800);
	}
	.jobs-title {
		font-size: clamp(22px, 2.6vw, 26px);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.01em;
	}
	.jobs-cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 48px;
		padding: 0 20px;
		background: var(--bn-negro);
		color: var(--bn-hueso);
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
		border-radius: var(--radius-s);
	}
	.jobs-cta :global(svg) {
		transition: transform var(--dur-base) var(--ease-out);
	}
	a.jobs-cta:hover {
		background: var(--bn-negro-700);
	}
	a.jobs-cta:hover :global(svg) {
		transform: translateX(4px);
	}
	.jobs-cta:focus-visible {
		outline-color: var(--bn-negro);
		box-shadow: 0 0 0 3px var(--bn-hueso);
	}

	@media (max-width: 720px) {
		.main {
			gap: 40px;
			padding-top: 16px;
		}
		.news {
			gap: 16px;
		}
		.news-grid :global(.news-main) {
			min-height: 420px;
		}
		.jobs-cta {
			width: 100%;
			justify-content: center;
		}
		.jobs--pronto {
			flex-direction: column;
			align-items: flex-start;
		}
		.jobs--pronto :global(.jobs-ilus) {
			width: 120px;
			height: auto;
		}
	}
</style>

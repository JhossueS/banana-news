---
import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';

export const prerender = false;

// Con sesión activa no tiene sentido ver el login
if (Astro.locals.usuario) return Astro.redirect('/admin');
const volver = Astro.url.searchParams.get('volver');
const destino = volver?.startsWith('/admin') ? volver : '/admin';
const activada = Astro.url.searchParams.has('activada');
---

<Layout title="Ingresar · Panel Banana News">
	<meta slot="head" name="robots" content="noindex, nofollow" />
	<main id="contenido" class="wrap wrap-login">
		<form class="card" id="form-login" data-destino={destino} novalidate>
			<span class="logo"><Logo height={32} /></span>
			<h1>Panel de la redacción</h1>
			<label class="field">
				<span>Correo</span>
				<input type="email" name="email" required autocomplete="username" inputmode="email" />
			</label>
			<label class="field">
				<span>Contraseña</span>
				<input type="password" name="password" required autocomplete="current-password" />
			</label>
			<button type="submit" class="btn">Ingresar</button>
			<button type="button" class="olvide" id="btn-olvide">¿Olvidaste tu contraseña?</button>
			<p class="status" id="login-status" role="status" aria-live="polite" data-kind={activada ? 'ok' : undefined}>
				{activada && 'Contraseña guardada. Ya puedes ingresar.'}
			</p>
		</form>
	</main>
</Layout>

<style>
	.wrap {
		display: grid;
		place-items: center;
		min-height: 100dvh;
		padding: 24px var(--gutter);
		background: var(--bn-negro);
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 16px;
		width: min(400px, 100%);
		padding: 32px;
		background: var(--bn-hueso);
		border-radius: var(--radius-m);
		box-shadow: inset 0 6px 0 var(--bn-amarillo);
	}
	h1 {
		font-size: 22px;
		font-weight: 800;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 13px;
		font-weight: 700;
	}
	.field input {
		min-height: 48px;
		padding: 0 14px;
		border: 0;
		border-radius: var(--radius-xs);
		background: #fff;
		box-shadow: inset 0 0 0 2px var(--bn-negro);
		font-size: 16px;
	}
	.field input:focus-visible {
		outline: 3px solid var(--bn-amarillo);
	}
	.btn {
		min-height: 48px;
		border: 0;
		border-radius: var(--radius-s);
		background: var(--bn-negro);
		color: var(--bn-hueso);
		font-size: 15px;
		font-weight: 800;
	}
	.btn:disabled {
		opacity: 0.6;
	}
	.status {
		min-height: 1.4em;
		font-size: 14px;
		font-weight: 700;
		color: var(--bn-coral-700);
	}
	.status[data-kind='ok'] {
		color: var(--bn-negro);
	}
	.olvide {
		align-self: center;
		padding: 4px;
		border: 0;
		background: none;
		font-size: 14px;
		font-weight: 700;
		text-decoration: underline;
		cursor: pointer;
	}
</style>

<script>
	const form = document.getElementById('form-login') as HTMLFormElement | null;
	const status = document.getElementById('login-status');

	// Pide un enlace para poner una contraseña nueva. La respuesta es la misma exista o no la cuenta.
	document.getElementById('btn-olvide')?.addEventListener('click', async () => {
		const email = String(new FormData(form!).get('email') ?? '').trim();
		status!.dataset.kind = '';
		if (!email) {
			status!.textContent = 'Escribe tu correo arriba y vuelve a pulsar «¿Olvidaste tu contraseña?».';
			return;
		}
		try {
			const res = await fetch('/api/auth/request-password-reset', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ email }),
			});
			if (res.status === 429) {
				status!.textContent = 'Ya pediste varios enlaces. Espera unos minutos.';
				return;
			}
			status!.dataset.kind = 'ok';
			status!.textContent = 'Si ese correo tiene una cuenta, te enviamos un enlace para poner una contraseña nueva (vence en 2 horas).';
		} catch {
			status!.textContent = 'No pudimos conectar. Revisa tu conexión e inténtalo de nuevo.';
		}
	});
	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const btn = form.querySelector('button')!;
		const data = Object.fromEntries(new FormData(form));
		if (!data.email || !data.password) {
			status!.textContent = 'Escribe tu correo y tu contraseña.';
			return;
		}
		btn.disabled = true;
		status!.textContent = '';
		status!.dataset.kind = '';
		try {
			const res = await fetch('/api/auth/sign-in/email', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify(data),
			});
			if (!res.ok) {
				status!.textContent = res.status === 429 ? 'Demasiados intentos. Espera un minuto.' : 'Correo o contraseña incorrectos.';
				return;
			}
			location.href = form.dataset.destino || '/admin';
		} catch {
			status!.textContent = 'No pudimos conectar. Revisa tu conexión e inténtalo de nuevo.';
		} finally {
			btn.disabled = false;
		}
	});
</script>

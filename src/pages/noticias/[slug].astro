---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Tag from '../../components/Tag.astro';
import StatusPill from '../../components/StatusPill.astro';
import NewsCard from '../../components/NewsCard.astro';
import Icon from '../../components/Icon.astro';
import Crumbs from '../../components/Crumbs.astro';
import Prose from '../../components/Prose.astro';

export async function getStaticPaths() {
	const noticias = await getCollection('noticias');
	return noticias.map((noticia) => ({ params: { slug: noticia.id }, props: { noticia } }));
}

interface Props {
	noticia: CollectionEntry<'noticias'>;
}

const { noticia } = Astro.props;
const n = noticia.data;
const { Content } = await render(noticia);

const fmtFecha = new Intl.DateTimeFormat('es-EC', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Guayaquil' });
const fmtHora = new Intl.DateTimeFormat('es-EC', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Guayaquil' });
const fecha = `${fmtFecha.format(n.fecha)} · ${fmtHora.format(n.fecha)}`;
const actualizado = n.actualizado ? `${fmtFecha.format(n.actualizado)} · ${fmtHora.format(n.actualizado)}` : null;

const palabras = (noticia.body ?? '').trim().split(/\s+/).length;
const minutos = Math.max(1, Math.round(palabras / 220));

const relacionadas = (await getCollection('noticias', (o) => o.id !== noticia.id))
	.sort((a, b) => Number(a.data.seccion !== n.seccion) - Number(b.data.seccion !== n.seccion) || b.data.fecha.valueOf() - a.data.fecha.valueOf())
	.slice(0, 3);

const og = await getImage({ src: n.imagen, width: 1200, format: 'jpg' });
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const shareText = encodeURIComponent(`${n.titulo} · Banana News`);
const shareUrl = encodeURIComponent(url);
---

<Layout title={`${n.titulo} · Banana News`} description={n.bajada} type="article" image={og.src}>
	<meta slot="head" property="article:published_time" content={n.fecha.toISOString()} />
	<meta slot="head" property="article:section" content={n.seccion} />

	<Header />

	<main id="contenido" class="wrap main">
		<Crumbs items={[{ label: 'Noticias', href: '/#noticias' }, { label: n.seccion }]} />

		<article class="nota" aria-labelledby="titulo">
			<header class="head">
				<div class="labels">
					<Tag size="md">{n.seccion}</Tag>
					{n.estado && <StatusPill kind={n.estado} />}
				</div>
				<h1 id="titulo" class="title">{n.titulo}</h1>
				<p class="deck">{n.bajada}</p>

				<div class="meta">
					<div class="byline">
						<span class="author">Por {n.autor}</span>
						<span class="meta-row">
							<time datetime={n.fecha.toISOString()}>{fecha}</time>
							<span aria-hidden="true">·</span>
							<span class="meta-icon"><Icon name="map-pin" size={14} />{n.lugar}</span>
							<span aria-hidden="true">·</span>
							<span class="meta-icon"><Icon name="clock" size={14} />{minutos} min de lectura</span>
						</span>
						{actualizado && <span class="meta-row">Actualizado: <time datetime={n.actualizado!.toISOString()}>{actualizado}</time></span>}
					</div>
					<ul class="share" aria-label="Compartir">
						<li>
							<a class="share-btn" href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener">
								<Icon name="message-circle" size={18} />
								<span class="sr-only">Compartir en </span>WhatsApp
							</a>
						</li>
						<li>
							<a class="share-btn" href={`https://x.com/intent/post?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener">
								<span class="sr-only">Compartir en </span>X
							</a>
						</li>
						<li>
							<button type="button" class="share-btn" id="copiar" data-url={url} data-title={n.titulo}>
								<Icon name="link" size={18} />
								<span id="copiar-label">Copiar enlace</span>
							</button>
						</li>
					</ul>
				</div>
			</header>

			<figure class="hero">
				<Image
					src={n.imagen}
					alt={n.alt}
					class="hero-img"
					widths={[640, 960, 1280, 1600]}
					sizes="(min-width: 1280px) 1216px, calc(100vw - 2 * var(--gutter))"
					loading="eager"
					fetchpriority="high"
				/>
				<figcaption><Icon name="camera" size={14} />{n.alt}. {n.credito}.</figcaption>
			</figure>

			<div class="layout">
				<div class="body">
					{
						n.claves && (
							<aside class="claves" aria-labelledby="h-claves">
								<h2 id="h-claves">Sin cáscara</h2>
								<ul>
									{n.claves.map((c) => (
										<li>{c}</li>
									))}
								</ul>
							</aside>
						)
					}
					<Prose>
						<Content />
					</Prose>

					<footer class="end">
						<p class="end-note">
							<Icon name="megaphone" size={18} />
							<span>¿Tienes información sobre este tema? <a href="/#denuncias">Envíanos tu denuncia</a>, puede ser anónima.</span>
						</p>
					</footer>
				</div>

				<aside class="rail" aria-label="Más contenido">
					<div class="ad">
						<span class="ad-label">Publicidad</span>
						<div class="ad-slot">
							<span class="ad-name">[TU ANUNCIO]</span>
							<span class="ad-size">300 × 250 · rectángulo</span>
						</div>
					</div>
				</aside>
			</div>
		</article>

		{
			relacionadas.length > 0 && (
				<section class="related" aria-labelledby="h-relacionadas">
					<div class="section-title">
						<h2 id="h-relacionadas" class="h2">Sigue leyendo</h2>
						<span class="underline" aria-hidden="true" />
					</div>
					<div class="related-grid">
						{relacionadas.map((r) => (
							<NewsCard
								variant="horizontal"
								image={r.data.imagen}
								alt={r.data.alt}
								kicker={r.data.seccion}
								title={r.data.titulo}
								deck={r.data.bajada}
								href={`/noticias/${r.id}/`}
							/>
						))}
					</div>
				</section>
			)
		}
	</main>

	<Footer />
</Layout>

<style>
	.main {
		display: flex;
		flex-direction: column;
		gap: 56px;
		padding-top: 20px;
	}

	/* Cabecera de la nota */
	.nota {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}
	.head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 18px;
		max-width: 900px;
	}
	.labels {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}
	.title {
		font-size: clamp(36px, 5.6vw, 64px);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.025em;
		max-width: 20ch;
	}
	/* Bajada con filete coral, como en la sección de denuncias */
	.deck {
		position: relative;
		max-width: 52ch;
		padding-left: 18px;
		font-size: clamp(18px, 2vw, 21px);
		font-weight: 500;
		line-height: 1.45;
	}
	.deck::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 6px;
		background: var(--bn-coral);
	}
	.meta {
		width: 100%;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 24px;
		margin-top: 6px;
		padding-top: 18px;
		border-top: 3px solid var(--bn-negro);
	}
	.byline {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.author {
		font-size: 15px;
		font-weight: 800;
	}
	.meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 8px;
		font-size: 13px;
		color: var(--bn-gris-600);
	}
	.meta-icon {
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}
	.share {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.share-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 14px;
		border: 0;
		background: transparent;
		color: var(--bn-negro);
		font-size: 14px;
		font-weight: 700;
		text-decoration: none;
		border-radius: var(--radius-s);
		box-shadow: inset 0 0 0 2px var(--bn-negro);
		transition: background var(--dur-fast) var(--ease-out);
	}
	.share-btn:hover {
		background: var(--bn-amarillo);
	}
	.share-btn:active {
		opacity: 0.85;
	}
	.share-btn[data-ok] {
		background: var(--bn-negro);
		color: var(--bn-hueso);
	}

	/* Foto principal */
	.hero {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.hero-img {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		background: var(--bn-gris-100);
	}
	figcaption {
		display: flex;
		align-items: flex-start;
		gap: 6px;
		font-size: 13px;
		line-height: 1.4;
		color: var(--bn-gris-600);
	}
	figcaption :global(svg) {
		margin-top: 2px;
	}

	/* Cuerpo + columna lateral */
	.layout {
		display: flex;
		flex-wrap: wrap;
		gap: 48px;
		align-items: flex-start;
	}
	.body {
		flex: 999 1 560px;
		min-width: 0;
		max-width: 720px;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}
	.rail {
		flex: 1 1 300px;
		max-width: 340px;
		position: sticky;
		top: 24px;
	}

	/* Claves: el resumen de la marca */
	.claves {
		padding: 22px 24px;
		background: var(--bn-amarillo);
		border-radius: var(--radius-xs);
	}
	.claves h2 {
		margin-bottom: 12px;
		font-size: 14px;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.claves ul {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.claves li {
		position: relative;
		padding-left: 22px;
		font-size: 17px;
		font-weight: 600;
		line-height: 1.4;
	}
	.claves li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.5em;
		width: 10px;
		height: 10px;
		background: var(--bn-negro);
	}

	/* Cierre */
	.end {
		padding-top: 20px;
		border-top: 1px solid var(--line-soft);
	}
	.end-note {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		font-size: 15px;
		line-height: 1.5;
	}
	.end-note :global(svg) {
		margin-top: 2px;
		color: var(--bn-coral-700);
	}
	.end-note a {
		font-weight: 700;
		text-decoration-color: var(--bn-coral);
	}

	/* Publicidad */
	.ad {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.ad-label {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--bn-gris-600);
	}
	.ad-slot {
		height: 250px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 24px;
		text-align: center;
		background: var(--bn-gris-100);
		box-shadow: inset 0 0 0 1px var(--bn-gris-200);
	}
	.ad-name {
		font-size: 20px;
		font-weight: 800;
	}
	.ad-size {
		font-size: 13px;
		color: var(--bn-gris-600);
	}

	/* Sigue leyendo */
	.related {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding-top: 32px;
		border-top: 3px solid var(--bn-negro);
	}
	.section-title {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.h2 {
		font-size: clamp(28px, 3.2vw, 36px);
		font-weight: 800;
		line-height: 1.06;
		letter-spacing: -0.015em;
	}
	.underline {
		width: 48px;
		height: 6px;
		background: var(--bn-amarillo);
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
		gap: 16px;
	}

	@media (max-width: 720px) {
		.main {
			gap: 40px;
			padding-top: 14px;
		}
		.nota {
			gap: 24px;
		}
		.head {
			gap: 14px;
		}
		.share {
			width: 100%;
		}
		.share li {
			flex: 1 1 auto;
		}
		.share-btn {
			width: 100%;
			justify-content: center;
		}
		/* La foto sangra a todo el ancho en móvil */
		.hero {
			margin-inline: calc(var(--gutter) * -1);
		}
		figcaption {
			padding-inline: var(--gutter);
		}
		.layout {
			gap: 32px;
		}
		.rail {
			position: static;
			max-width: none;
		}
		.ad-slot {
			height: 110px;
		}
		.claves {
			padding: 18px;
		}
		.claves li {
			font-size: 16px;
		}
	}
</style>

<script>
	const btn = document.getElementById('copiar') as HTMLButtonElement | null;
	const label = document.getElementById('copiar-label');
	btn?.addEventListener('click', async () => {
		const url = btn.dataset.url ?? location.href;
		try {
			// En móvil, la hoja nativa de compartir es más útil que copiar
			if (navigator.share && matchMedia('(pointer: coarse)').matches) {
				await navigator.share({ title: btn.dataset.title, url });
				return;
			}
			await navigator.clipboard.writeText(url);
			btn.dataset.ok = '';
			if (label) label.textContent = 'Enlace copiado';
			setTimeout(() => {
				delete btn.dataset.ok;
				if (label) label.textContent = 'Copiar enlace';
			}, 2000);
		} catch {
			// El usuario canceló o el navegador no permite el portapapeles
		}
	});
</script>
